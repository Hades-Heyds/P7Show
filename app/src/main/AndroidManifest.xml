<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 车机歌词读取：XuiServiceManager -> IXUIService -> IMediaCenter 所需权限 -->
    <uses-permission android:name="com.xiaopeng.xuimanager.permission.XUI_MEDIACENTER" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.P7Show">

        <activity
            android:name="com.show.p7.MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:configChanges="fontScale|layoutDirection|density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard|touchscreen|locale|mnc|mcc"
            android:theme="@style/Theme.P7Show.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.xiaopeng.intent.category.VIRTUAL_HOME_PRIMARY" />
                <category android:name="com.xiaopeng.intent.category.VIRTUAL_HOME_SECONDARY" />
            </intent-filter>

            <meta-data
                android:name="com.xiaopeng.metadata.activity.flags"
                android:value="0x1000000" />
            <meta-data
                android:name="com.xiaopeng.metadata.task.areas"
                android:value="secondary|primary|immersion" />
            <meta-data
                android:name="com.xiaopeng.metadata.task.screens"
                android:value="ivi" />
        </activity>

    </application>
</manifest>
